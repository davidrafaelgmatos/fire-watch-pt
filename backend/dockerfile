# Use OpenJDK for Java backend
FROM openjdk:17-jdk-slim

WORKDIR /app

# Copy Maven/Gradle wrapper and project files
COPY pom.xml ./
COPY src ./src

# Build project (Maven)
RUN apt-get update && apt-get install -y maven \
    && mvn clean package -DskipTests

# Expose port
EXPOSE 8080

# Run the app
CMD ["java", "-jar", "target/firewatch-backend.jar"]