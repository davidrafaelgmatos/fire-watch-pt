# Use Node.js LTS
FROM node:20-alpine

WORKDIR /app

# Copy only dependency files first (for better caching)
COPY package.json package-lock.json* pnpm-lock.yaml* yarn.lock* ./

# Install dependencies
RUN npm install

# Copy the rest of the project
COPY . .

# Build frontend
RUN npm run build

# Expose port
EXPOSE 3000

# Start app
CMD ["npm", "start"]
